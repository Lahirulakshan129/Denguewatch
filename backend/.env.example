NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=denguewatch
# true only for local/dev — never in production
DB_SYNC=true

SEED_ADMIN_EMAIL=admin@denguewatch.gov
SEED_ADMIN_PASSWORD=admin123
SEED_OFFICER_EMAIL=officer@denguewatch.gov
SEED_OFFICER_PASSWORD=officer123

PYTHON_EXECUTABLE=python
PYTHON_SCRIPT_PATH=./scripts/fetch_weather.py
JOB_TIMEOUT_MS=600000
JOB_MAX_RETRIES=2

# Local FastAPI or a hosted model endpoint that accepts POST /predict
ML_SERVICE_URL=http://localhost:8000

WEATHER_CSV_PATH=./data/weekly_weather.csv
DENGUE_CSV_PATH=./data/dengue_counts.csv
PREDICTION_CSV_PATH=./data/predictions.csv
LOGS_PATH=./logs/job-history.json

VISUAL_CROSSING_API_KEY=
