NODE_ENV=production
PORT=3001
# Comma-separated public origins of the hosted frontend
CORS_ORIGINS=https://your-frontend.example.com

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

DB_HOST=your-db-host
DB_PORT=5432
DB_USER=denguewatch
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=denguewatch
DB_SYNC=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

SEED_ADMIN_EMAIL=admin@your-domain
SEED_ADMIN_PASSWORD=replace-with-strong-admin-password
SEED_OFFICER_EMAIL=officer@your-domain
SEED_OFFICER_PASSWORD=replace-with-strong-officer-password

PYTHON_EXECUTABLE=python
PYTHON_SCRIPT_PATH=./scripts/fetch_weather.py
JOB_TIMEOUT_MS=600000
JOB_MAX_RETRIES=2

# Hosted model platform base URL (must expose POST /predict)
ML_SERVICE_URL=https://your-model-host.example.com

WEATHER_CSV_PATH=./data/weekly_weather.csv
DENGUE_CSV_PATH=./data/dengue_counts.csv
PREDICTION_CSV_PATH=./data/predictions.csv
LOGS_PATH=./logs/job-history.json

VISUAL_CROSSING_API_KEY=replace-with-api-key
